OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_MODEL=gemma-4-e4b-it@q4_k_m

# AI TTS defaults to OpenRouter's OpenAI-compatible speech API.
TTS_PROVIDER=openrouter
TTS_API_KEY=
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
TTS_VOICE=alloy
TTS_SPEED=1.0
TTS_RESPONSE_FORMAT=mp3
# Optional: map analyzed segment gender/speaker to provider voices.
# TTS_VOICE_MALE=onyx
# TTS_VOICE_FEMALE=nova
# TTS_VOICE_UNKNOWN=alloy
# TTS_VOICE_POOL_MALE=onyx,echo
# TTS_VOICE_POOL_FEMALE=nova,shimmer
# Optional: override the default expressive audiobook narrator prompt.
# Set TTS_INSTRUCTIONS to a single space in .env to disable style instructions.
# TTS_INSTRUCTIONS=Use an expressive Chinese audiobook narrator style with natural emotion, pauses, and emphasis.

# Optional override. Install ffmpeg separately or point this at a local executable.
FFMPEG_PATH=
