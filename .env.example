OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_MODEL=gemma-4-e4b-it@q4_k_m

# --- Option A: MiniMax for BOTH the analyzer and TTS (OpenAI-compatible text + t2a_v2 speech).
# MiniMax text is OpenAI-compatible, so the analyzer needs no other change. Use the same key for
# both, and keep the .cn / .minimaxi.com host: an api.minimax.io key is rejected (code 2049).
# OPENAI_API_KEY=sk-...your-minimax-key...
# OPENAI_BASE_URL=https://api.minimax.cn/v1
# OPENAI_MODEL=MiniMax-M3.1-Flash-Preview
# TTS_PROVIDER=minimax
# TTS_API_KEY=sk-...same-minimax-key...
# TTS_BASE_URL=https://api.minimax.cn/v1
# TTS_MODEL=speech-2.8-hd
# TTS_VOICE=female-yujie
# TTS_RESPONSE_FORMAT=wav
# Optional: force the speech language instead of letting MiniMax auto-detect.
# TTS_LANGUAGE_BOOST=Chinese
# MiniMax has no free-text instructions field; delivery comes from voice_setting.emotion.
# TTS_INSTRUCTIONS=
# TTS_VOICE_MALE=male-qn-jingying
# TTS_VOICE_FEMALE=female-yujie
# TTS_VOICE_UNKNOWN=female-chengshu
# TTS_VOICE_POOL_MALE=male-qn-qingse,male-qn-badao
# TTS_VOICE_POOL_FEMALE=female-shaonv,female-tianmei

# --- Option B (default): OpenRouter's OpenAI-compatible speech API.
TTS_PROVIDER=openrouter
TTS_API_KEY=
TTS_BASE_URL=https://openrouter.ai/api/v1
TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
TTS_VOICE=alloy
TTS_SPEED=1.0
TTS_RESPONSE_FORMAT=mp3
# Optional: map analyzed segment gender/speaker to provider voices.
# TTS_VOICE_MALE=onyx
# TTS_VOICE_FEMALE=nova
# TTS_VOICE_UNKNOWN=alloy
# TTS_VOICE_POOL_MALE=onyx,echo
# TTS_VOICE_POOL_FEMALE=nova,shimmer
# Optional: override the default expressive audiobook narrator prompt.
# Set TTS_INSTRUCTIONS to a single space in .env to disable style instructions.
# TTS_INSTRUCTIONS=Use an expressive Chinese audiobook narrator style with natural emotion, pauses, and emphasis.

# TTS retry policy for providers that report throttling as a business error (MiniMax 1002/1039).
# Applies to the minimax provider; OpenRouter relies on the OpenAI SDK's own retries.
# TTS_MAX_ATTEMPTS=3
# TTS_RETRY_BASE_DELAY=1.0
# TTS_TIMEOUT_SECONDS=60

# Optional override. Install ffmpeg separately or point this at a local executable.
# With TTS_PROVIDER=minimax + TTS_RESPONSE_FORMAT=wav the narration track needs no ffmpeg at all;
# it is still required for lyric-segment song mixing and for mp3 TTS output.
FFMPEG_PATH=
