# Text analysis: any OpenAI-compatible chat endpoint.
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_MODEL=gemma-4-e4b-it@q4_k_m

# Speech: MiniMax is the only provider (POST /v1/t2a_v2) and there is no provider switch.
# The same MiniMax key can serve both text and speech; keep the .cn / .minimaxi.com host,
# because a key issued for api.minimax.io is rejected by the China endpoint (and vice versa).
# TTS_API_KEY=sk-...your-minimax-key...
# TTS_BASE_URL=https://api.minimax.cn/v1
# TTS_MODEL=speech-2.8-hd            # or speech-2.8-turbo (cheaper, faster)
# TTS_VOICE=female-yujie             # any MiniMax voice id; "alloy" and friends do not exist here
# TTS_SPEED=1.0                      # clamped to MiniMax's allowed [0.5, 2]
# TTS_RESPONSE_FORMAT=wav            # wav = 22.05 kHz mono 16-bit, no ffmpeg needed for narration
# Optional: force the speech language instead of letting MiniMax auto-detect.
# TTS_LANGUAGE_BOOST=Chinese
# Optional: map the analyzed gender/speaker onto MiniMax voices.
# TTS_VOICE_MALE=male-qn-jingying
# TTS_VOICE_FEMALE=female-yujie
# TTS_VOICE_UNKNOWN=female-chengshu
# TTS_VOICE_POOL_MALE=male-qn-qingse,male-qn-badao
# TTS_VOICE_POOL_FEMALE=female-shaonv,female-tianmei
# MiniMax reports throttling as a business error, so synthesis retries with exponential backoff.
# TTS_MAX_ATTEMPTS=3
# TTS_RETRY_BASE_DELAY=1.0
# TTS_TIMEOUT_SECONDS=60

# Optional override. Install ffmpeg separately or point this at a local executable.
# TTS_RESPONSE_FORMAT=wav needs no ffmpeg for the narration track; it is still required for
# lyric-segment song mixing and for TTS_RESPONSE_FORMAT=mp3 output.
FFMPEG_PATH=
